# USAGE:
# docker build -t varscore-min -f Dockerfile.min .
# docker run --rm -v /data:/data varscore-min varscore.annotations -v /data/in.tsv -o /data/out.jsonl
#
# Lightweight image for variant annotation and filtering.
# CLI-based for direct execution in Prefect workflows.
# ------------------------------------------------

FROM python:3.9-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /code

# Install only the dependencies needed for annotation/filtering
RUN pip install --no-cache-dir \
    pandas>=1.3.4 \
    numpy==1.23.4 \
    pydantic>=2.0.0 \
    intervaltree>=3.1.0

# Copy only the necessary code
COPY varscore/__init__.py varscore/
COPY varscore/annotations.py varscore/
COPY varscore/prioritization.py varscore/
COPY varscore/utils/region_utils.py varscore/utils/
COPY varscore/utils/variant_utils.py varscore/utils/

# Copy only the required data files
COPY varscore/data/promoters_proteincoding.dnatree varscore/data/
COPY varscore/data/genes_proteincoding.dnatree varscore/data/
COPY varscore/data/exons_proteincoding.dnatree varscore/data/
COPY varscore/data/ccres.dnatree varscore/data/
COPY varscore/data/gene_df.tsv varscore/data/
COPY varscore/data/variants.pkl.gz varscore/data/

ENTRYPOINT ["python", "-m"]
